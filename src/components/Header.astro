---
import Arrow from "./Arrow.astro";
---

<header class="site-header">
  <a class="identity" href="/" aria-label="John Basham, home">
    <img
      class="site-logo"
      src="/assets/logo-text.png"
      alt="Good job"
      width="512"
      height="134"
      fetchpriority="high"
    />
  </a>
  <!-- <span class="header-role">
    John Basham
    <br />
    Product Designer &amp; Agentic Developer
  </span> -->
  <button
    class="menu-toggle"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="main-navigation"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav id="main-navigation" aria-label="Main navigation">
    <a href="/#journal">Journal</a>
    <a href="/work/">Work</a>
    <a href="/#experience">Experience</a>
    <a href="/#about">About</a>
    <a class="contact-nav" href="/contact/">
      Let’s talk <Arrow />
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = header?.querySelector<HTMLElement>("nav");

  if (header && toggle && nav) {
    header.classList.add("menu-ready");
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      header.classList.toggle("menu-open", open);
    };
    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
    nav.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setOpen(false);
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) {
        setOpen(false);
      }
    });
    window.matchMedia("(max-width: 600px)").addEventListener("change", () => {
      setOpen(false);
    });
  }
</script>

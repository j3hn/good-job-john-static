---
import Arrow from "./Arrow.astro";
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-content">
    <p class="hero-eyebrow">
      <span></span> Product Designer &amp; Engineer. 
    </p>
    <h1 id="hero-title">
      Hey. I’m John.
    </h1>
    <div class="hero-summary">
      <p>
        Independent by nature. Curious by default.
        <br class="desktop-break" /> I turn complex problems into useful,
        thoughtful products.
      </p>
      <a class="hero-cta" href="#journal">
        Explore my work <Arrow />
      </a>
    </div>
  </div>
  <img
    class="hero-portrait"
    src="/assets/portrait.svg"
    alt="Illustrated portrait of John Basham"
    width="488"
    height="511"
    fetchpriority="high"
  />
  <div class="hero-bottom">
    <span>
      Designing &amp; building at{" "}
      <a href="#journal">
        Flowforest <Arrow />
      </a>
    </span>
    <span class="hero-location">Nambucca Valley, Australia</span>
    <button
      class="motion-toggle"
      type="button"
      data-motion-toggle
      aria-pressed="false"
      hidden
    >
      <span data-motion-label>Pause motion</span>
      <span data-motion-symbol aria-hidden="true">
        Ⅱ
      </span>
    </button>
  </div>
</section>

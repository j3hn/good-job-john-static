---
import SiteLayout from "@layouts/SiteLayout.astro";
import RunwayArt from "@components/art/runway.astro";
import FlairArt from "@components/art/flair.astro";
import SlateArt from "@components/art/slate.astro";
import ExperimentGrid from "@components/ExperimentGrid.astro";
import BlockEditorShowcase from "@components/BlockEditorShowcase.astro";
import Hero from "@components/Hero.astro";
import ExperienceMap from "@components/ExperienceMap.astro";
import About from "@components/About.astro";
import VideoShowcase from "@components/VideoShowcase.astro";
import { festivalShowcase } from "../data/saltwater-freshwater";
import { sunnyCopyShowcase } from "../data/sunny-copy";
import { bellingenShowcase } from "../data/bellingen-destination";
import { goslingShowcase } from "../data/gosling";
import { allegraShowcase } from "../data/allegra";

const archiveWork = [
  {
    title: "Emma Power",
    href: "/emma-power/",
    image: "/uploads/2018/11/case-study-emma-power.jpg",
    alt: "Emma Power website design",
    width: 1650,
    height: 1020,
    tags: "Brand · Web design · Development",
    heading: "A clear stage for a writer, teacher and speaker.",
    copy: "A minimal website built around Emma’s words, with calm typography and subtle movement keeping the experience simple and easy to navigate.",
  },
  {
    title: "Sunny Copy",
    href: "/sunny-copy/",
    showcase: sunnyCopyShowcase,
    image: "/uploads/2019/05/case-study-sunny-copy-cmps.jpg",
    alt: "Sunny Copy website design",
    width: 1650,
    height: 1020,
    tags: "Brand · Web design · Development",
    heading: "A simple website where the words do the work.",
    copy: "Brand and website design for a creative copywriter, using a restrained visual system, small interactions and strong performance to keep the writing central.",
  },
  {
    title: "Jenna Meade",
    href: "/jenna-meade/",
    image: "/uploads/2018/12/case-study-jenna-meade-1650.jpg",
    alt: "Jenna Meade editorial website design",
    width: 1650,
    height: 1020,
    tags: "Web design · Development",
    heading: "A clear voice, on the web.",
    copy: "Website design and development for journalist and writer Jenna Meade. An earlier chapter of my independent practice.",
  },
  {
    title: "Soul Charters",
    href: "/soul-charters/",
    image: "/uploads/2019/06/soul-charters-home.png",
    alt: "Soul Charters website design",
    width: 1790,
    height: 1220,
    tags: "Brand · Web design · Development",
    heading: "A dreamlike digital home for retreats at sea.",
    copy: "A brand and website redesign pairing immersive imagery with a spacious reading experience to introduce yacht retreats and help facilitators imagine what is possible.",
  },
];
---

<SiteLayout
  title="Product Designer & Agentic Developer"
  description="John Basham is a Product Designer and Agentic Developer. A feed of products, experiments, notes and selected work."
  home={true}
>
  <Hero />
  <section id="feed" aria-label="Feed">
    <span id="journal" class="feed-legacy-anchor" aria-hidden="true"></span>
    <div class="feed-bar">
      <h2 class="eyebrow feed-title">01 / Feed</h2>
      <div class="filters" role="group" aria-label="Filter feed by category">
        <button data-filter="all" aria-pressed="true">
          All
        </button>
        <button data-filter="products" aria-pressed="false">
          Products
        </button>
        <button data-filter="experiments" aria-pressed="false">
          Experiments
        </button>
        <button data-filter="notes" aria-pressed="false">
          Notes
        </button>
        <button data-filter="selected" aria-pressed="false">
          Selected work
        </button>
      </div>
      <span id="filter-status" class="sr-only" aria-live="polite"></span>
    </div>
    <article class="feed-entry" data-category="products">
      <div class="entry-meta">
        <span>Product / Website</span>
        <span>2026 · Live</span>
      </div>
      <a
        class="art-link"
        href="/journal/flowforest-website/"
        aria-label="Read about the Flowforest website"
      >
        <img
          class="archive-image"
          src="/assets/flowforest-website/cover.png"
          alt="The Flowforest homepage with a fine contour drawing and the words Reduce the noise. Amplify the signal."
          width="1600"
          height="1000"
          loading="lazy"
        />
      </a>
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/journal/flowforest-website/">
              Flowforest website <span>↗</span>
            </a>
          </h2>
          <span class="tags">Website · Astro · Typography</span>
        </div>
        <div>
          <h3>Reduce the noise. Amplify the signal.</h3>
          <p>
            The public home for my independent practice. A quiet, typographic
            site that sets out what the tools believe, then shows the three
            products without overselling them.
          </p>
          <a class="text-link" href="/journal/flowforest-website/">
            Read the build note <span>↗</span>
          </a>
        </div>
      </div>
    </article>
    <article class="feed-entry" data-category="products">
      <div class="entry-meta">
        <span>Product / Development</span>
        <span>2026 · Building</span>
      </div>
      <a
        class="art-link"
        href="/journal/runway/"
        aria-label="Read the Runway build note"
      >
        <RunwayArt />
      </a>
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/journal/runway/">
              Runway <span>↗</span>
            </a>
          </h2>
          <span class="tags">Svelte · Markdown · SQLite</span>
        </div>
        <div>
          <h3>A home for your notes. Built around your files.</h3>
          <p>
            Exploring storage, sync and an editor that keeps Markdown on disk,
            with SQLite making it useful. Part of my independent practice,
            Flowforest.
          </p>
          <a class="text-link" href="/journal/runway/">
            Read the build note <span>↗</span>
          </a>
        </div>
      </div>
    </article>
    <article class="feed-entry" data-category="products">
      <div class="entry-meta">
        <span>Product / Development</span>
        <span>2026 · Building</span>
      </div>
      <a
        class="art-link"
        href="/journal/flair/"
        aria-label="Read the Flare build note"
      >
        <FlairArt />
      </a>
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/journal/flair/">
              Flare <span>↗</span>
            </a>
          </h2>
          <span class="tags">Android · Kotlin · Offline AI</span>
        </div>
        <div>
          <h3>Private voice notes, ready as Markdown.</h3>
          <p>
            Live English transcription happens entirely on your phone. Pause,
            tag and save a thought, then keep the Markdown file in a folder you
            choose.
          </p>
          <a class="text-link" href="/journal/flair/">
            Read the build note <span>↗</span>
          </a>
        </div>
      </div>
    </article>
    <article class="feed-entry" data-category="products">
      <div class="entry-meta">
        <span>Product / Development</span>
        <span>2026 · Building</span>
      </div>
      <a
        class="art-link"
        href="/journal/slate/"
        aria-label="Read the Slate build note"
      >
        <SlateArt />
      </a>
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/journal/slate/">
              Slate <span>↗</span>
            </a>
          </h2>
          <span class="tags">iPad · Swift · Metal</span>
        </div>
        <div>
          <h3>A quieter place to think with your hands.</h3>
          <p>
            A Pencil-first journal for iPad. Exploring the feel of digital ink,
            a custom brush engine and the simple rhythm of one page per day.
          </p>
          <a class="text-link" href="/journal/slate/">
            Read the build note <span>↗</span>
          </a>
        </div>
      </div>
    </article>
    <article class="feed-entry" data-category="experiments">
      <div class="entry-meta">
        <span>Experiment / Desktop tools</span>
        <span>2026 · Prototype</span>
      </div>
      <a
        class="art-link"
        href="/journal/block-editor/"
        aria-label="Read about the Block Editor experiment"
      >
        <BlockEditorShowcase />
      </a>
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/journal/block-editor/">
              Block Editor <span>↗</span>
            </a>
          </h2>
          <span class="tags">Gutenberg · Electron · React</span>
        </div>
        <div>
          <h3>The block editor, outside WordPress.</h3>
          <p>
            A standalone desktop experiment with Gutenberg’s editing canvas, a
            simple page list and local JSON files. A look at the prototype, with
            source code to explore.
          </p>
          <a class="text-link" href="/journal/block-editor/">
            Explore the experiment ↗
          </a>
        </div>
      </div>
    </article>
    <article class="feed-entry experiments-entry" data-category="experiments">
      <div class="entry-meta">
        <span>Research &amp; development</span>
        <span>Ongoing explorations</span>
      </div>
      <div class="experiments-heading">
        <div>
          <h2>A little room to experiment.</h2>
          <p>
            Small tools, visual studies and ideas followed out of curiosity.
            <br />A look inside my R&amp;D folder.
          </p>
        </div>
        <a class="text-link" href="/r%26d/">
          Explore all experiments ↗
        </a>
      </div>
      <ExperimentGrid showBlockEditor={false} />
    </article>
    <article class="feed-entry text-entry" data-category="notes">
      <div class="entry-meta">
        <span>Field notes</span>
        <span>September 2026</span>
      </div>
      <a href="/journal/design-and-code/">
        <span class="note-number">01 / On practice</span>
        <h2>
          The space between
          <br />
          design and code.
        </h2>
        <p>
          What I’m bringing from 15+ years of making things
          <br />
          into a practice of building with agents.
        </p>
        <span class="text-link">Read the note ↗</span>
      </a>
    </article>
    <article class="feed-entry text-entry" data-category="experiments">
      <div class="entry-meta">
        <span>Automation / n8n</span>
        <span>October 2026</span>
      </div>
      <a href="/journal/bus-351/">
        <span class="note-number">02 / Automation</span>
        <h2>
          Bus 351,
          <br />
          on schedule or late?
        </h2>
        <p>
          A weekday workflow that checks live departures
          <br />
          and sends one sentence to WhatsApp.
        </p>
        <span class="text-link">Read the build note ↗</span>
      </a>
    </article>
    <article class="feed-entry text-entry" data-category="experiments">
      <div class="entry-meta">
        <span>Automation / n8n</span>
        <span>October 2026</span>
      </div>
      <a href="/journal/solar-state-of-charge/">
        <span class="note-number">03 / Automation</span>
        <h2>
          Solar state
          <br />
          of charge.
        </h2>
        <p>
          An hourly message with one number,
          <br />
          straight from the Victron VRM API.
        </p>
        <span class="text-link">Read the build note ↗</span>
      </a>
    </article>
    <article class="feed-entry" data-category="selected">
      <div class="entry-meta">
        <span>Selected work / Shopify</span>
        <span>Phatduds</span>
      </div>
      <a
        class="art-link"
        href="/phatduds/"
        aria-label="Explore the Phatduds Shopify project"
      >
        <img
          class="archive-image"
          src="/assets/phatduds/cover.jpg"
          alt="Phatduds storefront design with basketball photography and bold red calls to action"
          width="1600"
          height="889"
          loading="lazy"
        />
      </a>
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/phatduds/">Phatduds ↗</a>
          </h2>
          <span class="tags">Shopify · E-commerce · Responsive design</span>
        </div>
        <div>
          <h3>Street ready. Court approved.</h3>
          <p>
            A Shopify storefront for basketball shorts and accessories, bringing
            a bold streetwear identity to desktop and mobile shopping.
          </p>
          <a class="text-link" href="/phatduds/">
            Explore the project ↗
          </a>
        </div>
      </div>
    </article>
    <article class="feed-entry" data-category="selected">
      <div class="entry-meta">
        <span>Selected work / Website</span>
        <span>Allegra School</span>
      </div>
      <VideoShowcase {...allegraShowcase} />
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/allegra/">Allegra School ↗</a>
          </h2>
          <span class="tags">Web design · Education</span>
        </div>
        <div>
          <h3>A welcoming place for a different way to learn.</h3>
          <p>
            A bold, people-led website for Allegra School in Coffs Harbour,
            bringing school life, useful information and enrolment into one
            welcoming experience.
          </p>
          <a class="text-link" href="/allegra/">
            Explore the project ↗
          </a>
        </div>
      </div>
    </article>
    <article class="feed-entry" data-category="selected">
      <div class="entry-meta">
        <span>Selected work / Website</span>
        <span>Bellingen Destination</span>
      </div>
      <VideoShowcase {...bellingenShowcase} />
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/bellingen-destination/">Bellingen Destination ↗</a>
          </h2>
          <span class="tags">Web design · Destination</span>
        </div>
        <div>
          <h3>A softer way to explore Bellingen.</h3>
          <p>
            A destination website concept bringing local places, events and
            community together.
          </p>
          <a class="text-link" href="/bellingen-destination/">
            Explore the project ↗
          </a>
        </div>
      </div>
    </article>
    <article class="feed-entry" data-category="selected">
      <div class="entry-meta">
        <span>Selected work / Website</span>
        <span>Saltwater Freshwater Festival</span>
      </div>
      <VideoShowcase {...festivalShowcase} />
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/saltwater-freshwater/">Saltwater Freshwater Festival ↗</a>
          </h2>
          <span class="tags">Web design · Development</span>
        </div>
        <div>
          <h3>A digital home for culture and connection.</h3>
          <p>
            Bold typography, warm colour and photography bring the festival to
            the screen, connecting the program, news and ways to get involved.
          </p>
          <a class="text-link" href="/saltwater-freshwater/">
            Explore the project ↗
          </a>
        </div>
      </div>
    </article>
    <article class="feed-entry" data-category="selected">
      <div class="entry-meta">
        <span>Selected work / Website</span>
        <span>Gosling Group</span>
      </div>
      <VideoShowcase {...goslingShowcase} />
      <div class="entry-copy">
        <div>
          <h2>
            <a href="/gosling/">Gosling Group ↗</a>
          </h2>
          <span class="tags">Web design · Responsive design</span>
        </div>
        <div>
          <h3>Built on trust. Designed for connection.</h3>
          <p>
            A digital home for electrical expertise, bringing commercial and
            residential services into one clear experience.
          </p>
          <a class="text-link" href="/gosling/">
            Explore the project and recording ↗
          </a>
        </div>
      </div>
    </article>
    {archiveWork.map((project) => (
      <article class="feed-entry" data-category="selected">
        <div class="entry-meta">
          <span>Selected work / Archive</span>
          <span>Independent practice</span>
        </div>
        {project.showcase ? (
          <VideoShowcase {...project.showcase} />
        ) : (
          <a
            href={project.href}
            aria-label={`Explore the ${project.title} project`}
          >
            <img
              class="archive-image"
              src={project.image}
              alt={project.alt}
              loading="lazy"
              width={project.width}
              height={project.height}
            />
          </a>
        )}
        <div class="entry-copy">
          <div>
            <h2>
              <a href={project.href}>{project.title} ↗</a>
            </h2>
            <span class="tags">{project.tags}</span>
          </div>
          <div>
            <h3>{project.heading}</h3>
            <p>{project.copy}</p>
            <a class="text-link" href={project.href}>
              Explore the project ↗
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>
  <ExperienceMap />
  <About />
</SiteLayout>

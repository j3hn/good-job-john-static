---
import SiteLayout from "@layouts/SiteLayout.astro";
import Hero from "@components/Hero.astro";
import WorkFeed from "@components/WorkFeed.astro";
import ImageEffect from "@components/ImageEffect.astro";
import ExperienceTimeline from "@components/ExperienceTimeline.astro";
import About from "@components/About.astro";
import ContactCTA from "@components/ContactCTA.astro";
---

<SiteLayout
  title="Product Design Engineer"
  description="John Basham — product designer and agentic developer in the Nambucca Valley, Australia. Independent product work through Flowforest, consulting at Goodjob."
  home={true}
>
  <ImageEffect />
  <span id="top" class="feed-anchor" aria-hidden="true"></span>
  <Hero />
  <section class="strip" aria-label="Current work">
    <div class="container strip-inner">
      <span class="strip-item">
        <span class="k">Designing &amp; building at</span>
        <a class="v" href="https://flowforest.com/">
          Flowforest
        </a>
      </span>
      <span class="strip-item">
        <span class="k">Consulting at</span>
        <a class="v" href="https://www.goodjob.dev/">
          Goodjob
        </a>
      </span>
      <span class="strip-item">
        <span class="k">Based in</span>
        <span class="v">Nambucca Valley, Australia</span>
      </span>
      <span class="strip-item">
        <span class="k">Experience</span>
        <span class="v">15+ years</span>
      </span>
    </div>
  </section>
  <WorkFeed />
  <ExperienceTimeline />
  <About />
  <ContactCTA />
</SiteLayout>

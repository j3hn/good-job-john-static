---
import ArticleLayout from "@layouts/ArticleLayout.astro";
import VideoShowcase from "@components/VideoShowcase.astro";
import { allegraShowcase } from "../../data/allegra";
---

<ArticleLayout
  title="Allegra School"
  description="A website for Allegra School in Coffs Harbour, bringing a supportive learning environment to life through bold colour, photography and clear navigation."
  eyebrow="Selected work / Website"
  subtitle="A welcoming place for a different way to learn."
  tags="Web design · Education"
  backHref="/work/"
  backText="← Back to selected work"
>
  <VideoShowcase slot="art" {...allegraShowcase} />

  <section>
    <h2>A school with room to be yourself.</h2>
    <p class="lead">
      A digital introduction to Allegra School in Coffs Harbour, where a
      supportive learning environment and individual strengths sit at the centre
      of the school experience.
    </p>
    <p>
      The website pairs a bold visual identity with photography of school life.
      Deep blue, fresh green and bright patterned accents create an energetic
      welcome, while generous typography makes the school’s message prominent.
    </p>
    <a
      class="text-link"
      href="https://allegra.nsw.edu.au/"
      target="_blank"
      rel="noopener noreferrer"
    >
      Visit Allegra School ↗
    </a>
  </section>

  <section>
    <h2>People before information.</h2>
    <p>
      The opening screen introduces the school through learning beyond the
      classroom. Curved shapes frame the photography, bringing the visual
      identity and the everyday experience of the school together.
    </p>
  </section>

  <section>
    <h2>A clear next step.</h2>
    <p>
      Navigation connects students and families with information about the
      school, resources and contact details. An enrolment link stays prominent,
      giving prospective families a clear place to continue.
    </p>
  </section>

  <a class="text-link" href="/work/">
    Explore more selected work ↗
  </a>
</ArticleLayout>

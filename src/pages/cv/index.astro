---
import SiteLayout from "@layouts/SiteLayout.astro";
---

<SiteLayout
  title="Experience"
  description="John Basham is a Product Designer and Agentic Developer. A journal of local-first products, design and development."
  home={false}
>
  <section class="article-page">
    <div class="article-heading">
      <span class="eyebrow">Experience</span>
      <h1>John Basham</h1>
      <p>Product Designer &amp; Agentic Developer</p>
      <span>
        Nambucca Valley, NSW ·<a href="mailto:john@basham.au">john@basham.au</a>
      </span>
    </div>
    <div class="article-prose">
      <p class="lead">
        15+ years bridging visual design, UI/UX, development and creative
        leadership. Now building independent, local-first products through
        Flowforest.
      </p>
      <section class="cv-role">
        <span class="eyebrow">2026 — Present</span>
        <h2>Flowforest</h2>
        <h3>Founder & Principal Designer</h3>
        <p>
          Independent research and design practice building local-first
          knowledge tools. Product strategy, UX and development across Runway,
          Flare and Slate.
        </p>
      </section>
      <section class="cv-role">
        <span class="eyebrow">2021 — 2026</span>
        <h2>We Are Coast</h2>
        <h3>Lead Front-End Designer/Developer</h3>
        <p>
          Led UI/UX and built custom WordPress and Shopify websites. Managed
          hosting, deployment and studio systems; contributed to project
          scoping, recruitment, mentoring and client training.
        </p>
      </section>
      <section class="cv-role">
        <span class="eyebrow">2018 — Present</span>
        <h2>Good job, John</h2>
        <h3>Founder / Web Consultant</h3>
        <p>
          Independent website design, development and consulting. Worked
          remotely for Australian and US clients while travelling through Europe
          and South East Asia.
        </p>
      </section>
      <section class="cv-role">
        <span class="eyebrow">2020 — 2021</span>
        <h2>Solos</h2>
        <h3>Dip-Tech Specialist</h3>
        <p>
          Ran digital ceramic glass printing production, prepared client artwork
          and solved commissioning and quality challenges.
        </p>
      </section>
      <section class="cv-role">
        <span class="eyebrow">2017 — 2018</span>
        <h2>Sketch & Etch</h2>
        <h3>CNC Machinist</h3>
        <p>
          Programmed and operated laser and router CNC machines. Developed
          signage, packaging and production processes.
        </p>
      </section>
      <section class="cv-role">
        <span class="eyebrow">2010 — 2015</span>
        <h2>In10tion Creative Agency</h2>
        <h3>Co-Founder / Creative Director</h3>
        <p>
          Led design and development, client relationships and delivery. Managed
          designers and developers, built custom websites and e-commerce stores,
          and built and sold an education portal.
        </p>
      </section>
      <section>
        <h2>Skills & tools</h2>
        <p>
          Product and interface design, UX, branding, motion, Figma and Adobe
          Creative Suite. HTML, CSS, JavaScript, Svelte, React, Node.js, PHP,
          WordPress and Shopify. Git, CI/CD, API integration, database and
          server administration.
        </p>
      </section>
      <section>
        <h2>Education</h2>
        <p>
          Bachelor of Arts (Visual Arts), Graphic Design & Multimedia —
          University of Ballarat, 2009.
        </p>
        <p>
          Advanced Diploma of Graphic Design & Multimedia — University of
          Ballarat, 2007.
        </p>
        <p>
          Mechatronic Engineering (Programming) studies — Deakin University,
          2016; one semester.
        </p>
      </section>
    </div>
  </section>
</SiteLayout>

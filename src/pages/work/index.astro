---
import SiteLayout from "@layouts/SiteLayout.astro";
import WorkFeed from "@components/WorkFeed.astro";
import ImageEffect from "@components/ImageEffect.astro";
import ContactCTA from "@components/ContactCTA.astro";
---

<SiteLayout
  title="Work"
  description="Websites, apps, tools and writing by John Basham. Selected work from We Are Coast, Goodjob and an independent product practice."
  wide={true}
>
  <ImageEffect />
  <WorkFeed standalone={true} />
  <section class="section archive-directory">
    <div class="section-head">
      <div>
        <p class="eyebrow">From the archive</p>
        <h2 class="h2">Identity in motion.</h2>
      </div>
      <div>
        <p class="lead">
          Earlier brand identities and motion work from Goodjob.
        </p>
        <p>
          <a class="btn btn-primary btn-arrow" href="/brand-motion/">
            Explore brand motion
          </a>
        </p>
      </div>
    </div>
    <div class="brand-archive">
      {[
        ["sunny", "Sunny Copy"],
        ["retrea", "Retrea"],
        ["soulfuel", "Soulfuel"],
        ["vifplastics", "VIF Plastics"],
        ["radical", "Radical"],
        ["autotelic", "Autotelic"],
        ["concreteworkshop", "Concrete Workshop"],
        ["billy", "Billy"],
        ["acceleron", "Acceleron"],
      ].map(([slug, name]) => (
        <img
          src={`/uploads/2021/10/logo-${slug}_desktop_x2.${slug === "retrea" ? "jpg" : "png"}`}
          alt={`${name} brand identity`}
          width="330"
          height="197"
          loading="lazy"
        />
      ))}
    </div>
  </section>
  <ContactCTA />
</SiteLayout>
<style>
  .brand-archive {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }
  .brand-archive img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 24px;
  }
  @media (max-width: 620px) {
    .brand-archive {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

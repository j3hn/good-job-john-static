---
import SiteLayout from "./SiteLayout.astro";
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  subtitle: string;
  tags?: string;
}
const {
  title,
  description,
  eyebrow = "2026 · Building / Flowforest",
  subtitle,
  tags,
} = Astro.props;
---

<SiteLayout title={title} description={description}>
  <article class="article-page">
    <a class="text-link" href="/#journal">
      ← Back to the journal
    </a>
    <div class="article-heading">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{subtitle}</p>
      {tags && <span class="tags">{tags}</span>}
    </div>
    <slot name="art" />
    <div class="article-prose">
      <slot />
    </div>
  </article>
</SiteLayout>

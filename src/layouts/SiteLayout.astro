---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ProjectCredit from "@components/ProjectCredit.astro";
import { postForPath, categoryLabels } from "../data/posts";
import "../styles/tokens.css";
import "../styles/legacy.css";
import "../styles/portfolio.css";
interface Props {
  title: string;
  description?: string;
  home?: boolean;
  wide?: boolean;
}
const {
  title,
  description = "John Basham — Product Designer and Agentic Developer. Products, experiments and notes from an independent practice.",
  home = false,
  wide = false,
} = Astro.props;
const post = postForPath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — John Basham</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff" />
    <meta property="og:title" content={`${title} — John Basham`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/uploads/2019/03/cropped-logo-heart-32x32.png" />
  </head>
  <body class:list={[{ "home-page": home }]}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <div class:list={[{ "page-content": !home && !wide }]}>
        {post && (
          <div class="post-context post-meta">
            <a class="meta" href={`/?category=${post.category}#work`}>
              ← {categoryLabels[post.category]}
            </a>
            <ProjectCredit employer={post.employer} />
          </div>
        )}
        <slot />
      </div>
    </main>
    <Footer />
    <script>
      import "../scripts/portfolio.ts";
    </script>
  </body>
</html>

---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "../styles/journal.css";
import "../styles/site.css";
interface Props {
  title: string;
  description?: string;
  home?: boolean;
}
const {
  title,
  description = "John Basham — Product Designer and Agentic Developer. Products, experiments and notes from an independent practice.",
  home = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — John Basham</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <meta property="og:title" content={`${title} — John Basham`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/uploads/2019/03/cropped-logo-heart-32x32.png" />
  </head>
  <body class:list={[{ "home-page": home }]}>
    {home && (
      <div class="home-backdrop" aria-hidden="true" data-shader-backdrop>
        <canvas data-shader></canvas>
        <div class="home-grain"></div>
      </div>
    )}
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/journal.js";
    </script>
  </body>
</html>
